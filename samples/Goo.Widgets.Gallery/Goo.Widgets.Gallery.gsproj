<Project Sdk="Gsharp.NET.Sdk/0.5.212">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Goo.Widgets.Gallery</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Goo.Widgets/Goo.Widgets.gsproj" />
    <ProjectReference Include="../../src/Goo.Widgets.Markdown/Goo.Widgets.Markdown.gsproj" />
    <Watch Include="**/*.gs" Exclude="bin/**;obj/**" />
    <None Include="Fonts/*;Assets/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
