<Project Sdk="Gsharp.NET.Sdk/0.4.591">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../samples/Goo.Widgets.Gallery/Gallery.gs" Link="Gallery/Gallery.gs" />
    <Compile Include="../../samples/Goo.Widgets.Gallery/Pages/**/*.gs" Link="Gallery/Pages/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="Goo" Version="0.5.4-preview.2" />
    <PackageReference Include="Goo.Svg" Version="0.5.4-preview.2" />
    <PackageReference Include="Markdig" Version="0.38.0" />
    <Reference Include="Goo.Widgets">
      <HintPath>../../artifacts/package/lib/net10.0/Goo.Widgets.dll</HintPath>
    </Reference>
    <Reference Include="Goo.Widgets.Markdown">
      <HintPath>../../artifacts/markdown-package/lib/net10.0/Goo.Widgets.Markdown.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
