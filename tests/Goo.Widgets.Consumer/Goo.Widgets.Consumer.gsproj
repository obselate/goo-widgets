<Project Sdk="Gsharp.NET.Sdk/0.5.212">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../samples/Goo.Widgets.Gallery/Gallery.gs" Link="Gallery/Gallery.gs" />
    <Compile Include="../../samples/Goo.Widgets.Gallery/Pages/**/*.gs" Link="Gallery/Pages/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../samples/Goo.Widgets.Gallery/Assets/GooMark*.svg" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Goo" Version="0.30.0-local.3" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <Reference Include="Goo.Widgets">
      <HintPath>../../artifacts/package/lib/net10.0/Goo.Widgets.dll</HintPath>
    </Reference>
    <Reference Include="Goo.Widgets.Markdown">
      <HintPath>../../artifacts/markdown-package/lib/net10.0/Goo.Widgets.Markdown.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
