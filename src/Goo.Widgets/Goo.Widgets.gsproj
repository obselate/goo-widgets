<Project Sdk="Gsharp.NET.Sdk/0.5.212">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Goo.Widgets</RootNamespace>
    <AssemblyName>Goo.Widgets</AssemblyName>
    <Version>0.21.0</Version>
    <PackageId>Goo.Widgets</PackageId>
    <Title>Goo Widgets</Title>
    <Authors>obselate</Authors>
    <Description>Composable, customizable widgets for Goo desktop applications, grouped by category.</Description>
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/obselate/goo-widgets</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/obselate/goo-widgets</PackageProjectUrl>
    <PackageTags>goo;gsharp;widgets;desktop;ui</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeWidgetDocumentation</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Goo" Version="0.29.0" />
    <ProjectReference Include="../../tools/Goo.Widgets.Checks/Goo.Widgets.Checks.gsproj" ReferenceOutputAssembly="false" PrivateAssets="all" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
    <EmbeddedResource Include="$(IntermediateOutputPath)MaterialSymbols.bundle" LogicalName="Goo.Widgets.MaterialSymbols.bundle" />
    <EmbeddedResource Include="Shaders/touch_magnifier.goo-effect" LogicalName="Goo.Widgets.TouchMagnifier" />
    <EmbeddedResource Include="ILLink.Substitutions.xml" LogicalName="ILLink.Substitutions.xml" />
    <None Include="../../buildTransitive/Goo.Widgets.targets" Pack="true" PackagePath="buildTransitive/Goo.Widgets.targets" />
    <None Include="../../buildTransitive/MaterialSymbols.Subset" Pack="true" PackagePath="buildTransitive/MaterialSymbols.Subset" />
    <None Include="../../assets/material-symbols/outlined/*.svg" Pack="true" PackagePath="buildTransitive/icons/%(Filename)%(Extension)" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../assets/material-symbols/LICENSE" Pack="true" PackagePath="licenses/material-symbols/" />
    <None Include="../../assets/material-symbols/README.md" Pack="true" PackagePath="licenses/material-symbols/" />
  </ItemGroup>
  <Target Name="GenerateMaterialSymbols" BeforeTargets="CoreCompile"
          Inputs="../../assets/material-symbols/outlined;../../assets/material-symbols/outlined/*.svg;../../tools/Goo.Widgets.Checks/bin/$(Configuration)/net10.0/Goo.Widgets.Checks.dll"
          Outputs="$(IntermediateOutputPath)MaterialSymbols.bundle">
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)../../tools/Goo.Widgets.Checks/bin/$(Configuration)/net10.0/Goo.Widgets.Checks.dll&quot; bundle &quot;$(IntermediateOutputPath)MaterialSymbols.bundle&quot;" />
  </Target>
  <Target Name="PopulateWidgetDocumentation" AfterTargets="CoreCompile" Condition="'$(DocumentationFile)' != ''">
    <ItemGroup>
      <DocFileItem Include="$(DocumentationFile)" />
      <FinalDocFile Include="$(OutDir)$([System.IO.Path]::GetFileName('$(DocumentationFile)'))" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeWidgetDocumentation">
    <ItemGroup>
      <BuildOutputInPackage Include="$(TargetDir)Goo.Widgets.xml">
        <TargetPath>Goo.Widgets.xml</TargetPath>
        <FinalOutputPath>$(TargetDir)Goo.Widgets.xml</FinalOutputPath>
      </BuildOutputInPackage>
    </ItemGroup>
  </Target>
</Project>
