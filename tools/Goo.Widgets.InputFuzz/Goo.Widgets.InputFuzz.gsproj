<Project Sdk="Gsharp.NET.Sdk/0.5.212">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Goo.Widgets/Goo.Widgets.gsproj" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <Compile Include="../../src/Goo.Widgets.Markdown/**/*.gs" Link="Markdown/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
